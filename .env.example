# ws-gateway 의 y-websocket 엔드포인트 (room = 페이지 UUID 를 코드에서 append)
# 편집에는 gateway(:8080) + crdt-engine(:50051) 이 모두 떠 있어야 한다.
VITE_WS_URL=ws://localhost:8080/ws/doc

# doc-service REST 베이스 URL — 로그인·워크스페이스·페이지 API. CORS 화이트리스트에 이 앱의 origin
# (http://localhost:5173)이 이미 등록돼 있다(doc-service SecurityConfig).
VITE_API_URL=http://localhost:8081

# ⚠️ E2E(`npm run test:e2e`)는 이 파일을 읽지 않는다 — vitest 는 process.env 만 본다.
#    엔드포인트를 바꾸려면 셸 환경변수로: E2E_WS_URL · E2E_API_URL (README §E2E)
